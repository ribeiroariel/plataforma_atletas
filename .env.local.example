NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Só usada pelo script local scripts/import-planilhas.mjs (Etapa 4).
# NUNCA prefixar com NEXT_PUBLIC_ e NUNCA subir isso para a Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Strava (criar app em https://www.strava.com/settings/api).
# CLIENT_ID é público; CLIENT_SECRET é server-only (vai na Vercel, mas SEM NEXT_PUBLIC_).
NEXT_PUBLIC_STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
